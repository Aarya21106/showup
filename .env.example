# --- Server ---
PORT=3000
# Public URL this server is reachable at (ngrok URL locally, real domain in prod).
# Used to build the poster image URL Twilio fetches, and the landing page wa.me link.
PUBLIC_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app

# --- Twilio WhatsApp Sandbox ---
# From https://console.twilio.com -> Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Sandbox number, always whatsapp:+14155238886 unless you have your own Twilio WA number
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# The join code shown on your Twilio Sandbox page (Messaging -> Try it out -> Send a WhatsApp message)
# e.g. if the sandbox says "join brave-tiger", set this to brave-tiger
TWILIO_SANDBOX_CODE=join-code-here

# --- Google Gemini (free tier) ---
# Get a free key in ~1 minute at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# --- Razorpay ---
# Create a Payment Link at https://dashboard.razorpay.com/app/payment-links and paste the URL
PAYMENT_LINK_URL=https://rzp.io/i/your-payment-link

# --- Admin view (bare, password-gated) ---
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# --- Program config ---
TIMEZONE=Asia/Kolkata
PLEDGE_DAYS=30
DEPOSIT_AMOUNT_INR=300
FULL_PAYOUT_INR=500
SLIP_PENALTY_INR=50
