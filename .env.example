# --- Server ---
PORT=3000
# Public URL this server is reachable at (for poster image URLs).
PUBLIC_BASE_URL=https://your-domain.com

# --- Firebase Auth ---
# Download from Firebase Console -> Project Settings -> Service accounts -> Generate new private key
# Save the JSON file in the project root and set the path here.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# --- Google Gemini (free tier) ---
# Get a free key in ~1 minute at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# --- Razorpay ---
# Create a Payment Link at https://dashboard.razorpay.com/app/payment-links and paste the URL
PAYMENT_LINK_URL=https://razorpay.me/@your-handle

# --- Admin view (bare, password-gated) ---
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# --- Program config ---
TIMEZONE=Asia/Kolkata
PLEDGE_DAYS=30
DEPOSIT_AMOUNT_INR=300
FULL_PAYOUT_INR=500
SLIP_PENALTY_INR=50
