# --- Server ---
PORT=3000
# Public URL this server is reachable at (for poster image URLs).
PUBLIC_BASE_URL=https://your-domain.com

# --- Firebase Auth ---
# Download from Firebase Console -> Project Settings -> Service accounts -> Generate new private key
# Save the JSON file in the project root and set the path here.
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# --- Google Gemini (free tier) ---
# Get a free key in ~1 minute at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# --- Razorpay ---
# Create TWO separate Payment Links at https://dashboard.razorpay.com/app/payment-links —
# one for the Basic tier amount, one for the Pro tier amount — and paste each URL below.
# The bot now sends the correct link automatically based on which tier the user picked.
# PAYMENT_LINK_URL (no suffix) is kept as a fallback used only if a tier-specific link isn't set.
PAYMENT_LINK_URL=https://razorpay.me/@your-handle
PAYMENT_LINK_URL_BASIC=https://razorpay.me/@your-handle/basic-amount
PAYMENT_LINK_URL_PRO=https://razorpay.me/@your-handle/pro-amount

# --- Google Sign-In ---
# 1. Go to https://console.cloud.google.com/apis/credentials (use/create the same
#    project your Firebase project uses, if you have one).
# 2. Create an OAuth 2.0 Client ID of type "Web application" (this is required even
#    though the app is Android-only — the native library uses it as the token audience).
# 3. Also create an OAuth 2.0 Client ID of type "Android", using package name
#    com.showup.fitness and your app's SHA-1 signing certificate fingerprint
#    (get it from `eas credentials` for your Android build profile). This one has no
#    values to copy anywhere — Google just needs it registered so sign-in isn't blocked.
# 4. Paste the WEB client ID (ends in .apps.googleusercontent.com) below AND in
#    mobile/app.json under expo.extra.googleWebClientId — they must match.
GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com

# --- Turso (persistent database mirror) ---
# Render's free plan has an EPHEMERAL filesystem — the local SQLite file is wiped
# on every redeploy and container restart. Turso (free, SQLite-compatible) mirrors
# every write so data survives. Sign up at https://turso.tech (free), then:
#   turso db create showup
#   turso db show showup --url          -> TURSO_DATABASE_URL
#   turso db tokens create showup       -> TURSO_AUTH_TOKEN
# If these are left unset, the app runs fine locally but data will NOT survive a
# redeploy on Render's free plan.
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token

# --- Admin view (bare, password-gated) ---
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# --- Program config ---
TIMEZONE=Asia/Kolkata
PLEDGE_DAYS=30
DEPOSIT_AMOUNT_INR=300
FULL_PAYOUT_INR=500
SLIP_PENALTY_INR=50
